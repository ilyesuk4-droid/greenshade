# PatchNature — Configuration Supabase
# Renseignez ces variables dans votre environnement local (.env) ou sur votre hébergeur (Vercel / Cloudflare)

# Supabase Project URL & Anon/Publishable Key (Frontend & Server)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server-only / Admin operations, optional)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
